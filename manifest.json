{
  "manifest_version": 3,
  "name": "build_trancy",
  "version": "0.1.0",
  "description": "Session 1: mirror YouTube native captions into our overlay",
  "browser_specific_settings": {
    "gecko": {
      "id": "build-trancy@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
